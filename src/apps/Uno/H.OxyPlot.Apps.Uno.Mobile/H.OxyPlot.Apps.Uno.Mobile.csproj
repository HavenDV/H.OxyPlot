<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-ios;net10.0-maccatalyst -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <SingleProject>true</SingleProject>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-ios'">iossimulator-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">maccatalyst-x64</RuntimeIdentifier>
    <InvariantGlobalization Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">true</InvariantGlobalization>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">23.0</SupportedOSPlatformVersion>
    <!-- Debugger workaround https://github.com/dotnet/maui-samples/blob/8aa6b8780b12e97b157514c3bdc54bb4a13001cd/HelloMacCatalyst/HelloMacCatalyst.csproj#L7 -->
    <!-- <MtouchExtraArgs Condition="'$(TargetFramework)' == 'net6.0-maccatalyst'">$(MtouchExtraArgs) -setenv:MONO_THREADS_SUSPEND=preemptive</MtouchExtraArgs> -->
    <IsUnoHead>true</IsUnoHead>
    <NoWarn>$(NoWarn);NU1603;NU1703</NoWarn>
    <DefineConstants>$(DefineConstants);HAS_UNO;HAS_WINUI;HAS_UNO_WINUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!--<Using Include="Windows.UI.Xaml.Controls.Button" Alias="Button" />-->
    <Compile Remove="iOS\**\*.cs;MacCatalyst\**\*.cs;macOS\**\*.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Uno.WinUI" />
    <PackageReference Include="Uno.UI.Adapter.Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-android'">
    <PackageReference Include="Uno.UniversalImageLoader" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-ios' or '$(TargetFramework)'=='net10.0-maccatalyst'">
    <PackageReference Include="Uno.Extensions.Logging.OSLog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\H.OxyPlot.Uno.WinUI\H.OxyPlot.Uno.WinUI.csproj" />
    <ProjectReference Include="..\..\H.OxyPlot.Apps.Core\H.OxyPlot.Apps.Core.csproj" />
  </ItemGroup>

  <Import Project="..\..\H.OxyPlot.Apps.Shared\H.OxyPlot.Apps.Shared.projitems" Label="Shared" />
  <Import Project="..\..\H.OxyPlot.Apps.Uno.Shared\H.OxyPlot.Apps.Uno.Shared.projitems" Label="Shared" />

</Project>
